{
  "name": "sky-delivery-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.node.json && tsc -p tsconfig.save.json && tsc -p tsconfig.app.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.render.json",
    "test": "vitest run",
    "headless": "node --disable-warning=ExperimentalWarning tools/headless.ts",
    "campaign": "node --disable-warning=ExperimentalWarning tools/campaign.ts",
    "autoplay": "node --disable-warning=ExperimentalWarning tools/autoplay.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "pixi.js": "8.22.0",
    "preact": "11.1.0"
  }
}
